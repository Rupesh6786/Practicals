<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>WelcomeServlet1</servlet-name>
        <servlet-class>WelcomeServlet1</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Prac2bServlet</servlet-name>
        <servlet-class>Prac2bServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Prac2cServlet</servlet-name>
        <servlet-class>Prac2cServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>QuizApp</servlet-name>
        <servlet-class>QuizApp</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>MarksServlet</servlet-name>
        <servlet-class>MarksServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookServlet</servlet-name>
        <servlet-class>BookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WelcomeServlet1</servlet-name>
        <url-pattern>/WelcomeServlet1</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Prac2bServlet</servlet-name>
        <url-pattern>/Prac2bServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Prac2cServlet</servlet-name>
        <url-pattern>/Prac2cServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>QuizApp</servlet-name>
        <url-pattern>/QuizApp</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>MarksServlet</servlet-name>
        <url-pattern>/MarksServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookServlet</servlet-name>
        <url-pattern>/BookServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
